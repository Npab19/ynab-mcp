# Get your YNAB Personal Access Token from:
# https://app.ynab.com/settings/developer
YNAB_API_KEY=your_ynab_personal_access_token_here

# Secret token used to authenticate MCP clients.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=your_random_secret_token_here

# Cloudflare Tunnel token (get from Cloudflare Zero Trust dashboard)
Cloudflare_Token=your_cloudflare_tunnel_token_here

# --- Connecting Claude to this server ---
#
# Claude.ai web connectors (syncs across all devices):
#   Set the connector URL to:
#   https://<your-tunnel-url>/mcp?api_key=<MCP_BEARER_TOKEN>
#
# Claude Desktop (claude_desktop_config.json):
#   {
#     "mcpServers": {
#       "ynab": {
#         "type": "http",
#         "url": "https://<your-tunnel-url>/mcp",
#         "headers": { "Authorization": "Bearer <MCP_BEARER_TOKEN>" }
#       }
#     }
#   }
